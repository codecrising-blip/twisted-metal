; Engine configuration file.
; Godot 4.3

config_version=5

[application]

config/name="Twisted Metal"
config/description="Vehicular combat: TM2 Los Angeles test stage, Sweet Tooth against four AI cars."
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.3", "GL Compatibility")
config/icon="res://icon.svg"

[display]

window/size/viewport_width=1600
window/size/viewport_height=900
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[layer_names]

3d_physics/layer_1="world"
3d_physics/layer_2="vehicles"
3d_physics/layer_3="projectiles"
3d_physics/layer_4="pickups"

[physics]

common/physics_ticks_per_second=60

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"

limits/opengl/max_lights_per_object=32
limits/opengl/max_renderable_lights=256

anti_aliasing/quality/msaa_3d=2
environment/defaults/default_clear_color=Color(0.02, 0.02, 0.03, 1)
